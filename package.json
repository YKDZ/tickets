{
  "name": "tickets",
  "private": true,
  "type": "module",
  "imports": {
    "#npm-publication/*": "./scripts/npm-publication/*.ts"
  },
  "scripts": {
    "boundaries": "node --conditions=source scripts/run-turbo-boundaries.ts && node --conditions=source scripts/check-toolchain-versions.ts",
    "check": "node --conditions=source scripts/task-gates.ts check",
    "check:full": "node --conditions=source scripts/task-gates.ts check:full",
    "check:heavy": "node --conditions=source scripts/task-gates.ts check:heavy",
    "fix": "node --conditions=source scripts/task-gates.ts fix",
    "format:check": "oxfmt --list-different --no-error-on-unmatched-pattern package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.json tsconfig.config.json *.config.ts .pnpmfile.mjs .gitignore .dockerignore Dockerfile TODO.md rust-toolchain.toml .vscode .github .devcontainer scripts",
    "format:write": "oxfmt --write --no-error-on-unmatched-pattern package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.json tsconfig.config.json *.config.ts .pnpmfile.mjs .gitignore .dockerignore Dockerfile TODO.md rust-toolchain.toml .vscode .github .devcontainer scripts",
    "lint": "oxlint --quiet --format=unix --no-error-on-unmatched-pattern *.config.ts .pnpmfile.mjs scripts",
    "lint:fix": "oxlint --format=unix --no-error-on-unmatched-pattern *.config.ts .pnpmfile.mjs scripts --fix",
    "publication:artifact": "node --conditions=source scripts/npm-publication/check-artifact.ts",
    "publication:readiness": "node --conditions=source scripts/npm-publication/check-readiness.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/semver": "catalog:",
    "@types/spdx-expression-parse": "catalog:",
    "npm": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "semver": "catalog:",
    "smol-toml": "catalog:",
    "spdx-expression-parse": "catalog:",
    "tar": "catalog:",
    "turbo": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  },
  "packageManager": "pnpm@12.9.1"
}
