{
  "extends": ["//"],
  "tags": ["app"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!ticket-graph.schema.json"],
      "outputs": ["dist/**", "ticket-graph.schema.json"],
      "tags": ["quality:light"]
    },
    "format:check": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "format:write": {
      "dependsOn": ["lint:fix"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "lint": {
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "lint:fix": {
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["work:repair"]
    },
    "postbuild": {
      "inputs": [],
      "outputs": [],
      "tags": ["work:lifecycle"]
    },
    "prepack": {
      "inputs": [],
      "outputs": [],
      "tags": ["work:release"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "inputs": [],
      "outputs": [],
      "cache": false,
      "tags": ["quality:heavy"],
      "env": ["TICKETS_PACKED_BIN", "TICKETS_PACKED_PACKAGE_ROOT"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": [],
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
